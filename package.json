{
  "name": "maplibre-valhalla-navigation",
  "version": "1.0.0",
  "description": "Beautiful turn-by-turn navigation system using MapLibre GL JS and Valhalla routing",
  "main": "dist/index.js",
  "scripts": {
    "dev": "webpack serve --mode development",
    "build": "webpack --mode production",
    "type-check": "tsc --noEmit",
    "serve": "python3 -m http.server 8080 --directory dist"
  },
  "dependencies": {
